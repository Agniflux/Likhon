// likhon_tsf.dll resources: the icon Windows shows for the Likhon keyboard (index 0, Win+Space) and in the input
// indicator: the Likhon logo (owner, 2026-10-24; src/langbar.rs).
#include <winver.h>

1 ICON "../assets/icons/likhon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,1,0
PRODUCTVERSION 0,2,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Likhon Bangla keyboard (text service)"
      VALUE "ProductName", "Likhon"
      VALUE "FileVersion", "0.2.1"
      VALUE "ProductVersion", "0.2.1"
      VALUE "OriginalFilename", "likhon_tsf.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
