# Fedora RPM package for Likhon. build-rpm.sh replaces @RPM_VERSION@ and stages
# the payload in the RPM source directory.
# Binaries are prebuilt outside rpmbuild, so debuginfo is useless.
%global debug_package %{nil}

Name:           ibus-likhon
Version:        @RPM_VERSION@
Release:        1%{?dist}
Summary:        Likhon, free Bangla phonetic typing for IBus
# The engine links MIT and Apache-2.0 crates, and their notices are in the
# licence directory. A Fedora submission would need a full SPDX expression.
License:        MPL-2.0
URL:            https://likhon.agniflux.com
Requires:       ibus >= 1.5
# Any Bangla font; Fedora resolves it to default-fonts-bn.
Requires:       font(:lang=bn)
# The first-run agreement blocks typing until it is accepted, and Fedora does
# not install a dialog by default.
Requires:       zenity

%description
Likhon, free Bangla phonetic typing for IBus. Type Bangla with English letters
(ami -> আমি). Shows the word being typed with suggestions from a built-in
dictionary, and commits it when it ends.
Nothing you type is sent anywhere. Learned words stay on your computer.

After installing, add "Likhon (Bangla phonetic)" under Settings > Keyboard >
Input Sources (GNOME), or run ibus-setup on other desktops. If it does not
appear, run: ibus restart

%prep
# Nothing to unpack: build-rpm.sh already placed the payload in the source directory.

%build
# Nothing to build: the engine is prebuilt by ./build.sh before rpmbuild runs.

%install
rm -rf "%{buildroot}"
cp -a "%{_sourcedir}/tree/." "%{buildroot}/"

%files
%defattr(-,root,root,-)
%dir /usr/lib/ibus-likhon
%dir /usr/share/ibus-likhon
%dir /usr/share/licenses/ibus-likhon
%dir /usr/share/doc/ibus-likhon
/usr/lib/ibus-likhon/ibus-engine-likhon
/usr/lib/ibus-likhon/likhon-agreement
/usr/bin/likhon-delete-words
/usr/share/ibus-likhon/agreement.en.txt
/usr/share/ibus-likhon/agreement.bn.txt
/usr/share/ibus-likhon/words.sqlite
/usr/share/ibus-likhon/SOURCE.md
%license /usr/share/ibus-likhon/LICENSE
/usr/share/ibus/component/likhon.xml
%license /usr/share/licenses/ibus-likhon/LICENSE
%license /usr/share/licenses/ibus-likhon/NOTICE
%license /usr/share/licenses/ibus-likhon/NOTICES.md
%license /usr/share/licenses/ibus-likhon/NOTICE.txt
%license /usr/share/licenses/ibus-likhon/avro-keyboard-MPL-2.0.txt
%license /usr/share/licenses/ibus-likhon/khipro-MIT.txt
%license /usr/share/licenses/ibus-likhon/unicode-cldr.txt
%license /usr/share/licenses/ibus-likhon/rust-crates.txt
%doc /usr/share/doc/ibus-likhon/SOURCE-OFFER.txt

%changelog
* Thu Nov 26 2026 Agniflux Enterprise <info@agniflux.com> - @RPM_VERSION@-1
- Fedora RPM package.
